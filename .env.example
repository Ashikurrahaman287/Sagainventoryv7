# ──────────────────────────────────────────────────────────────
#  Saga Inventory — Environment Variables
#  Copy this file to .env and fill in your values before running:
#    cp .env.example .env
# ──────────────────────────────────────────────────────────────

# PostgreSQL password for the database container
POSTGRES_PASSWORD=changeme_secure_password

# Port the app will be accessible on your machine (default: 5000)
APP_PORT=5000

# Secret used to sign session cookies — use a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# The login password for the web app
APP_PASSWORD=ASHIK123456789@00
